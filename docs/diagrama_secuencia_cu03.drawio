        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Operador as :OperadorGarita\n    participant UI as :GatewaysUI (Next.js)\n    participant Backend as :ControladorGateways (Express)\n    participant Pedido as :Pedido\n    participant Gateway as :Gateway\n    participant MotorEDA as :MotorAsignacionEDA0 (EDA 0)\n\n    Operador-&gt;&gt;UI: solicitarAsignacion(codPedido)\n    activate UI\n    UI-&gt;&gt;Backend: POST /api/gateways/asignar { codPedido }\n    activate Backend\n\n    Backend-&gt;&gt;Pedido: esCargaConstruccion()\n    activate Pedido\n    Pedido--&gt;&gt;Backend: boolean (esConstruccion)\n    deactivate Pedido\n\n    alt RN-08: Insumos de Construcción (Exclusivo GW 5)\n        Backend-&gt;&gt;Gateway: consultarDisponibilidad(idGateway: 5)\n        activate Gateway\n        Gateway--&gt;&gt;Backend: disponible: true\n        deactivate Gateway\n\n        Backend-&gt;&gt;Gateway: ocuparBahia(codPedido)\n        activate Gateway\n        Gateway--&gt;&gt;Backend: 200 OK (GW 5 Ocupado)\n        deactivate Gateway\n\n    else Carga General (Gateways 1 al 4)\n        Backend-&gt;&gt;Gateway: consultarDisponibilidad(rango: 1..4)\n        activate Gateway\n        Gateway--&gt;&gt;Backend: estadoBahiasGeneral\n        deactivate Gateway\n\n        alt Bahía General Disponible\n            Backend-&gt;&gt;Gateway: ocuparBahia(codPedido)\n            activate Gateway\n            Gateway--&gt;&gt;Backend: 200 OK (GW Asignado)\n            deactivate Gateway\n        else Saturación de Bahías Generales (Cola EDA 0)\n            Backend-&gt;&gt;MotorEDA: evaluarPrioridad(registro)\n            activate MotorEDA\n            MotorEDA-&gt;&gt;MotorEDA: calcularPesoMinHeap()\n            MotorEDA--&gt;&gt;Backend: prioridadCalculada\n            deactivate MotorEDA\n\n            Backend-&gt;&gt;MotorEDA: encolarEnEspera(registro)\n            activate MotorEDA\n            MotorEDA--&gt;&gt;Backend: posicionEnCola: 1\n            deactivate MotorEDA\n        end\n    end\n\n    Backend--&gt;&gt;UI: 200 OK { status, gatewayAsignado, posicionCola }\n    deactivate Backend\n    UI--&gt;&gt;Operador: renderizarResultadoAsignacion()\n    deactivate UI&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="IcRi9BKqvm7kBE41PAqg-1">
