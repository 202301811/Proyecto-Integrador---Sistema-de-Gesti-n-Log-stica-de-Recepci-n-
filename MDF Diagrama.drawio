  <diagram name="Page-1" id="NcJxHb61urOW0AAmXWvb">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Usuario {\n        -String idUsuario\n        -String nombreCompleto\n        -String email\n        -String hashPassword\n        -EnumRol rolUsuario\n        +autenticar(password) Boolean\n        +recuperarPassword() Void\n        +obtenerRol() EnumRol\n    }\n\n    class Administrador {\n        +configurarParametros() Void\n    }\n\n    class OperadorGarita {\n        +registrarLlegada() Void\n        +asignarBahia() Void\n    }\n\n    class Proveedor {\n        -String idProveedor\n        -String razonSocial\n        -String nit\n        -EnumCategoria categoria\n        -String telefonoContacto\n        +registrarProveedor() Boolean\n        +esProveedorActivo() Boolean\n    }\n\n    class Pedido {\n        -String codPedido\n        -String idProveedor\n        -EnumTipoCarga tipoCarga\n        -Double volumenM3\n        -Double pesoKg\n        -EnumEstadoPedido estadoPedido\n        +esCargaConstruccion() Boolean\n        +actualizarEstado(nuevoEstado) Void\n    }\n\n    class CitaLogistica {\n        -String idCita\n        -String codPedido\n        -Date fechaHoraProgramada\n        -Integer ventanaToleranciaMin\n        -EnumEstadoCita estadoCita\n        +reprogramarCita(nuevaFecha, motivo) Boolean\n        +estaEnTolerancia(horaLlegadaReal) Boolean\n    }\n\n    class RegistroGarita {\n        -String idRegistro\n        -String idCita\n        -String placaVehiculo\n        -String nombreConductor\n        -Date timestampLlegadaReal\n        -EnumPuntualidad clasificacionPuntualidad\n        +registrarLlegadaReal(codPedido, timestamp) Void\n        +calcularClasificacion(toleranciaMin) EnumPuntualidad\n    }\n\n    class Gateway {\n        -Integer idGateway\n        -String nombreBahia\n        -EnumEstadoGateway estadoGateway\n        -Boolean esExclusivoConstruccion\n        +ocuparBahia(codPedido) Boolean\n        +liberarBahia() Void\n        +alternarMantenimiento() Void\n    }\n\n    class ParametroSistema {\n        -String idParametro\n        -String clave\n        -Integer valorNumerico\n        -String descripcion\n        +actualizarParametro(nuevoValor) Boolean\n        +obtenerValor(clave) Integer\n    }\n\n    class MotorAsignacionEDA0 {\n        -String algoritmoPrioridad\n        -PriorityQueue colaEsperaActiva\n        -Integer tiempoMaximoEsperaMin\n        +evaluarPrioridad(registro) Integer\n        +asignarGatewayExclusivo(pedido) Gateway\n        +aplicarAgingEnCola() Void\n    }\n\n    %% Relaciones de Herencia\n    Usuario &lt;|-- Administrador\n    Usuario &lt;|-- OperadorGarita\n\n    %% Relaciones de Negocio\n    Proveedor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Pedido : suministra\n    Pedido \&quot;1\&quot; -- \&quot;1\&quot; CitaLogistica : agenda\n    CitaLogistica \&quot;1\&quot; *-- \&quot;1\&quot; RegistroGarita : compone\n    RegistroGarita \&quot;0..*\&quot; o-- \&quot;1\&quot; Gateway : asigna\n    Gateway -- MotorAsignacionEDA0 : gestiona\n\n    %% Dependencias\n    MotorAsignacionEDA0 ..&gt; Pedido : evalua\n    MotorAsignacionEDA0 ..&gt; RegistroGarita : prioriza\n    ParametroSistema ..&gt; RegistroGarita : parametriza&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="N0s_suDwq_p4QOXbhoSd-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
